{
  "name": "site-chat",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @site-chat/web dev",
    "build": "pnpm --filter @site-chat/shared build && pnpm --filter @site-chat/ai build && pnpm --filter @site-chat/widget build && pnpm --filter @site-chat/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "gen:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:types:check": "tmp=$(mktemp) && supabase gen types typescript --local > \"$tmp\" && diff -u packages/shared/src/database.types.ts \"$tmp\" && rm \"$tmp\"",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "local:refresh": "node scripts/local-refresh.mjs",
    "local:restart": "node scripts/local-restart.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@site-chat/eslint-config": "workspace:*",
    "@site-chat/prettier-config": "workspace:*",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
