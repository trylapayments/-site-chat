# Copy to runtime/web.env (ignored). Use staging credentials only.
SITE_CHAT_IMAGE=site-chat:staging-REPLACE_WITH_COMMIT
NEXT_PUBLIC_APP_URL=https://REPLACE_APP_DOMAIN
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_API_DOMAIN
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_STAGING_ANON_JWT
SUPABASE_SERVICE_ROLE_KEY=REPLACE_STAGING_SERVICE_ROLE_JWT
SUPABASE_JWT_SECRET=REPLACE_STAGING_JWT_SECRET
AUTH_COOKIE_SECRET=REPLACE_RANDOM_32_BYTE_SECRET
WIDGET_EMBED_SECRET=REPLACE_RANDOM_32_BYTE_SECRET
RATE_LIMIT_SECRET=REPLACE_RANDOM_32_BYTE_SECRET
# Only isolated synthetic-data staging may enable the mock AI provider.
AI_ALLOW_MOCK_PROVIDER=true
