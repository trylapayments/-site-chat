# =============================================================================
# Site Chat — Environment Variables
# Copy to .env.local for local development: cp .env.example .env.local
# =============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth redirect URLs (local)
# Production/staging: set exact callback URLs in Supabase Dashboard.
# Preview: https://site-chat-<hash>.vercel.app/auth/callback and /auth/recovery
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signed auth flow cookies (sc_recovery). Use: openssl rand -base64 32
AUTH_COOKIE_SECRET=your-auth-cookie-secret-min-32-chars

# Widget embed token HMAC secret. Use: openssl rand -base64 32
WIDGET_EMBED_SECRET=your-widget-embed-secret-min-32-chars

# Rate limit bucket key HMAC secret. Use: openssl rand -base64 32
RATE_LIMIT_SECRET=your-rate-limit-secret-min-32-chars
