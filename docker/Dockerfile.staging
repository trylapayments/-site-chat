# Build public configuration into Next.js; never pass server secrets as build args.
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
COPY . .
RUN pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    SUPABASE_SERVICE_ROLE_KEY=build-only-placeholder-service-role-key \
    SUPABASE_JWT_SECRET=build-only-placeholder-jwt-secret-32-characters \
    AUTH_COOKIE_SECRET=build-only-placeholder-auth-secret-32-characters \
    WIDGET_EMBED_SECRET=build-only-placeholder-embed-secret-32-characters \
    RATE_LIMIT_SECRET=build-only-placeholder-rate-secret-32-characters \
    NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
COPY --from=build --chown=node:node /app /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
USER node
EXPOSE 3000
CMD ["pnpm", "--filter", "@site-chat/web", "exec", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
